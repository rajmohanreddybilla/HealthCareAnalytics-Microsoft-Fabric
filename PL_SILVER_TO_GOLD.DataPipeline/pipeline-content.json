                }
              ]
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "UPDATE ctrl.audit_log\nSET\n    status = 'SUCCESS',\n    end_time = CAST(SYSUTCDATETIME() AS DATETIME2(6)),\n    records_written = @{activity('Silver to Gold').output.result.exitValue}\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\nAND table_id = @{item().table_id}",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "HealthCareAnalyticsWH",
                "properties": {
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "artifactId": "63ba7174-5cbc-9570-4f65-e961310ae723",
                    "endpoint": "bfuznrz7drzudguoboor2baura-4xtbix42zdwu7axoxukxzoreky.datawarehouse.fabric.microsoft.com",
