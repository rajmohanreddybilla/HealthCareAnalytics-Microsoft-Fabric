                "scripts": [
                  {
                    "text": {
                      "value": "update ctrl.audit_log\nset status = 'FAILED', end_time = CAST(SYSUTCDATETIME() AS DATETIME2(6))\nWHERE adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{item().table_id}",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "HealthCareAnalyticsWH",
                "properties": {
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "artifactId": "63ba7174-5cbc-9570-4f65-e961310ae723",
                    "endpoint": "bfuznrz7drzudguoboor2baura-4xtbix42zdwu7axoxukxzoreky.datawarehouse.fabric.microsoft.com",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "annotations": []
                }
              },
